# Copy to backend/.env and fill in the keys you have.
# Missing keys degrade that tool/engine; the pipeline still completes.

# --- LLM providers (heterogeneous engines) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- News / verification APIs ---
NEWSAPI_KEY=
GUARDIAN_API_KEY=
GNEWS_API_KEY=
NEWSDATA_API_KEY=
FACTCHECK_API_KEY=
HF_TOKEN=

# --- Logging (INFO or DEBUG) ---
LOG_LEVEL=INFO

# --- Pinned models (override only if needed) ---
PREPROCESS_MODEL=gpt-4.1
QUERY_PLANNER_MODEL=claude-sonnet-4-6
EVIDENCE_LLM_MODEL=gemini-2.5-flash
UNCERTAINTY_MODEL=gpt-4o-mini
DOCUMENTATION_MODEL=claude-sonnet-4-6
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
NER_MODEL=dslim/bert-base-NER
