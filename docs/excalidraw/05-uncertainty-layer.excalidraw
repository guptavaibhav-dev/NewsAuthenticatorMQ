    {
      "id": "validate-title",
      "type": "text",
      "x": 76,
      "y": 804,
      "width": 1848,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-validate"
      ],
      "frameId": null,
      "index": "c9",
      "roundness": null,
      "seed": 1343481722,
      "version": 1,
      "versionNonce": 135987118,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Validation and fallback \u2014 the rules keep the last word",
      "originalText": "Validation and fallback \u2014 the rules keep the last word",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "validate-body",
      "type": "text",
      "x": 76,
      "y": 832.5,
      "width": 1848,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-validate"
      ],
      "frameId": null,
      "index": "d0",
      "roundness": null,
      "seed": 1984447899,
      "version": 1,
      "versionNonce": 180127882,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Risk must be one of low \u00b7 moderate \u00b7 high \u00b7 unknown, and the label must be one of the six newsroom labels. Anything else is discarded and the rule-based value is kept.\nEmpty lists coming back from the model fall back to the rule-based unknowns and weak-evidence flags, so this layer can never return silently empty.\nWhichever engine actually produced the payload is recorded on the envelope \u2014 \u201crule-based\u201d when the model was skipped, failed, or rejected.",
      "originalText": "Risk must be one of low \u00b7 moderate \u00b7 high \u00b7 unknown, and the label must be one of the six newsroom labels. Anything else is discarded and the rule-based value is kept.\nEmpty lists coming back from the model fall back to the rule-based unknowns and weak-evidence flags, so this layer can never return silently empty.\nWhichever engine actually produced the payload is recorded on the envelope \u2014 \u201crule-based\u201d when the model was skipped, failed, or rejected.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
