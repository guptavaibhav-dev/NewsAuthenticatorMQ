    {
      "id": "ner-title",
      "type": "text",
      "x": 1036,
      "y": 432,
      "width": 828,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
