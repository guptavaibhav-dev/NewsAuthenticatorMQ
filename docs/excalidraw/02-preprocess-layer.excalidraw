    {
      "id": "llm-body",
      "type": "text",
      "x": 76,
      "y": 460.5,
      "width": 868,
      "height": 187.5,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-llm"
      ],
      "frameId": null,
      "index": "c4",
      "roundness": null,
      "seed": 496635096,
      "version": 1,
      "versionNonce": 1124885143,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Preferred: GPT-4.1. If that is down: Claude, then Gemini.\nReads the article and extracts:\n\u2022 content type (article, claim, headline, social post)\n\u2022 headline\n\u2022 atomic check-worthy claims, labelled c1, c2, \u2026\n\u2022 fact vs opinion\n\u2022 a first pass at people, organisations, places, dates\n\u2022 a date window for later search\nTold not to judge whether the story is true.\nIf no LLM is available, long sentences become claims.",
      "originalText": "Preferred: GPT-4.1. If that is down: Claude, then Gemini.\n\nReads the article and extracts:\n\u2022 content type (article, claim, headline, social post)\n\u2022 headline\n\u2022 atomic check-worthy claims, labelled c1, c2, \u2026\n\u2022 fact vs opinion\n\u2022 a first pass at people, organisations, places, dates\n\u2022 a date window for later search\n\nTold not to judge whether the story is true.\nIf no LLM is available, long sentences become claims.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
