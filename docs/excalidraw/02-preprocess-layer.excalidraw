      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Reconcile \u2014 keep both answers visible",
      "originalText": "Reconcile \u2014 keep both answers visible",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "merge-body",
      "type": "text",
      "x": 316,
      "y": 840.5,
      "width": 1308,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-merge"
      ],
      "frameId": null,
      "index": "d0",
      "roundness": null,
      "seed": 448129623,
      "version": 1,
      "versionNonce": 1810235103,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Claims come from the LLM (or the sentence fallback).\nEntities are combined. A name both engines saw is tagged \u201cboth\u201d.\nA name only one engine saw is kept, and listed as a disagreement \u2014 not discarded.\nDate window: use the LLM\u2019s window; otherwise \u00b12 days around a date found in the text.",
      "originalText": "Claims come from the LLM (or the sentence fallback).\nEntities are combined. A name both engines saw is tagged \u201cboth\u201d.\nA name only one engine saw is kept, and listed as a disagreement \u2014 not discarded.\nDate window: use the LLM\u2019s window; otherwise \u00b12 days around a date found in the text.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
