      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "1 rel=canonical  2 og:url  3 final URL\nDeclared URLs accepted only if the\nregistrable domain matches; else fall\nthrough and log \u00b7 canonical_source records it\nUnwrap redirectors + AMP, strip utm_*, fbclid\npublisher_id splits platform authors",
      "originalText": "1 rel=canonical  2 og:url  3 final URL\nDeclared URLs accepted only if the\nregistrable domain matches; else fall\nthrough and log \u00b7 canonical_source records it\nUnwrap redirectors + AMP, strip utm_*, fbclid\npublisher_id splits platform authors",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
