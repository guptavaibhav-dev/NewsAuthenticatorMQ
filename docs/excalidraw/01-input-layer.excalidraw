      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Overlap check on normalised forms only:\ncasefold, NFKC, collapse spaces,\ncurly quotes/dashes \u2192 ASCII\nraw_text itself is never mutated\nsegments tile raw_text exactly\ntext_merged is derived from segments",
      "originalText": "Overlap check on normalised forms only:\ncasefold, NFKC, collapse spaces,\ncurly quotes/dashes \u2192 ASCII\nraw_text itself is never mutated\nsegments tile raw_text exactly\ntext_merged is derived from segments",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
