    {
      "id": "nli-body",
      "type": "text",
      "x": 76,
      "y": 456.5,
      "width": 868,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-nli"
      ],
      "frameId": null,
      "index": "c4",
      "roundness": null,
      "seed": 1517638801,
      "version": 1,
      "versionNonce": 494522336,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Preferred: DeBERTa. If that is down: BART MNLI, then lexical overlap.\nFor each claim \u00d7 article snippet it returns:\nentailment \u00b7 contradiction \u00b7 neutral, with a confidence.\nIt does not write prose and cannot invent a verdict.\nIf there are no pairs, that is recorded as empty \u2014 not as false.",
      "originalText": "Preferred: DeBERTa. If that is down: BART MNLI, then lexical overlap.\n\nFor each claim \u00d7 article snippet it returns:\nentailment \u00b7 contradiction \u00b7 neutral, with a confidence.\n\nIt does not write prose and cannot invent a verdict.\nIf there are no pairs, that is recorded as empty \u2014 not as false.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
