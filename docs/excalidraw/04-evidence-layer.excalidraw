      "versionNonce": 1279306259,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Engine B \u2014 blinded Gemini (then Claude)",
      "originalText": "Engine B \u2014 blinded Gemini (then Claude)",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "llm-body",
      "type": "text",
      "x": 1036,
      "y": 456.5,
      "width": 828,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-llm"
      ],
      "frameId": null,
      "index": "c7",
      "roundness": null,
      "seed": 496635096,
      "version": 1,
      "versionNonce": 1124885143,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Sees only the claims and the evidence list. It is not given DeBERTa labels, the existence\nclass, or a requested verdict.\nFor each claim it lists which source_ids support, refute, or are unrelated, plus slot clashes\n(date, place, number, actor).\nInvented source IDs are dropped. If Gemini is down, fusion continues on NLI alone.",
      "originalText": "Sees only the claims and the evidence list. It is not given DeBERTa labels, the existence class, or a requested verdict.\n\nFor each claim it lists which source_ids support, refute, or are unrelated, plus slot clashes (date, place, number, actor).\n\nInvented source IDs are dropped. If Gemini is down, fusion continues on NLI alone.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
