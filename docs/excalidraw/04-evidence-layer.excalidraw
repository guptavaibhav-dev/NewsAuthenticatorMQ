      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Deterministic fusion \u2014 a rule, not a third model",
      "originalText": "Deterministic fusion \u2014 a rule, not a third model",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "fuse-body",
      "type": "text",
      "x": 76,
      "y": 832.5,
      "width": 1848,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-fuse"
      ],
      "frameId": null,
      "index": "d0",
      "roundness": null,
      "seed": 98198801,
      "version": 1,
      "versionNonce": 1808155956,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Count support and contradiction by publisher family, not by URL (bbc.com and bbc.co.uk are one family).\nAgreement: convergent \u00b7 contested \u00b7 NLI-only \u00b7 LLM-only \u00b7 none.\nThen overlay Layer 3 existence to pick a corroboration state: corroborated coverage \u00b7 event corroborated \u00b7 single source \u00b7 contested reporting \u00b7 no corroboration found.\nNo true/false probability is produced.",
      "originalText": "Count support and contradiction by publisher family, not by URL (bbc.com and bbc.co.uk are one family).\nAgreement: convergent \u00b7 contested \u00b7 NLI-only \u00b7 LLM-only \u00b7 none.\nThen overlay Layer 3 existence to pick a corroboration state: corroborated coverage \u00b7 event corroborated \u00b7 single source \u00b7 contested reporting \u00b7 no corroboration found.\nNo true/false probability is produced.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
