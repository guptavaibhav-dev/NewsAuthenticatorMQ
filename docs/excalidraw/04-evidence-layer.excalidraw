    {
      "id": "nli-title",
      "type": "text",
      "x": 76,
      "y": 444,
      "width": 868,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-nli"
      ],
      "frameId": null,
      "index": "c7",
