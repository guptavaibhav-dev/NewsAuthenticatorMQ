    {
      "id": "fuse-title",
      "type": "text",
      "x": 76,
      "y": 872,
      "width": 1848,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-fuse"
      ],
      "frameId": null,
      "index": "d3",
