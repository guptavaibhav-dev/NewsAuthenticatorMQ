    {
      "id": "llm-body",
      "type": "text",
      "x": 1036,
      "y": 456.5,
      "width": 828,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
