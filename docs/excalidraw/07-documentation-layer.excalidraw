      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "template-body",
      "type": "text",
      "x": 76,
      "y": 456.5,
      "width": 868,
      "height": 150.0,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-template"
      ],
      "frameId": null,
      "index": "c4",
      "roundness": null,
      "seed": 1693657342,
      "version": 1,
      "versionNonce": 549116636,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Filled from the envelope, no model required:\n\u2022 claims listed by id\n\u2022 retrieved outlets, or \u201cno portal hits \u2260 falsity\u201d\n\u2022 existence class, corroboration state, independent source count\n\u2022 per-claim NLI / Gemini agreement\n\u2022 uncertainty rationale and unknowns\n\u2022 citations (article URLs + fact-check URLs)\nThis template is the fallback if every LLM is down.",
      "originalText": "Filled from the envelope, no model required:\n\u2022 claims listed by id\n\u2022 retrieved outlets, or \u201cno portal hits \u2260 falsity\u201d\n\u2022 existence class, corroboration state, independent source count\n\u2022 per-claim NLI / Gemini agreement\n\u2022 uncertainty rationale and unknowns\n\u2022 citations (article URLs + fact-check URLs)\n\nThis template is the fallback if every LLM is down.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
