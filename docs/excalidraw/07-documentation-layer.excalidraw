      "seed": 496635096,
      "version": 1,
      "versionNonce": 1124885143,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773320000000,
      "link": null,
      "locked": false,
      "text": "Rewrites the template as short, citation-backed prose. Instructed: do not issue a truth\nverdict.\nCite evidence by outlet and URL. Keep each section to 1\u20133 paragraphs.\nIf Claude is down, Gemini then OpenAI try. If all fail, the template stands and the failure is\ntraced.",
      "originalText": "Rewrites the template as short, citation-backed prose. Instructed: do not issue a truth verdict.\n\nCite evidence by outlet and URL. Keep each section to 1\u20133 paragraphs.\n\nIf Claude is down, Gemini then OpenAI try. If all fail, the template stands and the failure is traced.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
